# --- General ---
ENVIRONMENT=development
API_SECRET_KEY=change-me-to-a-random-secret

# --- API authentication ---
# Disabled by default: CyberLab binds to 127.0.0.1 only out of the box, so
# there's no untrusted network path to the API. Set to "true" (and a real
# random API_SECRET_KEY above) before exposing CyberLab beyond localhost --
# see docs/security.md. When enabled, the frontend automatically sends
# API_SECRET_KEY as a bearer token (docker-compose.yml wires this through).
AUTH_ENABLED=false

# --- LAN access ---
# By default CyberLab only binds to 127.0.0.1 (this machine only). To reach
# it from another device on your network:
#   1. Set HOST_IP below to this machine's LAN IP (`hostname -I`).
#   2. Add http://<HOST_IP>:<FRONTEND_PORT> to CORS_ORIGINS below.
#   3. Set AUTH_ENABLED=true above with a real API_SECRET_KEY -- required,
#      see docs/security.md for what this does and does not protect against
#      on a shared network.
#   4. In docker-compose.yml, change the frontend/api "ports:" bindings from
#      127.0.0.1:... to 0.0.0.0:... (commented example there).
# Leave as "localhost" for local-only access (the default).
HOST_IP=localhost

# --- Ports exposed on the host (remapped to avoid conflicts with other local stacks) ---
FRONTEND_PORT=3300
API_PORT=8300
POSTGRES_PORT=55432
REDIS_PORT=63790

# --- PostgreSQL ---
POSTGRES_DB=cyberlab
POSTGRES_USER=cyberlab
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://cyberlab-redis:6379/0

# --- Ollama (reuses the Ollama instance already running on the host) ---
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# --- CORS ---
CORS_ORIGINS=http://localhost:3300

# --- Kali agent (internal network only, shared secret between api/worker and kali) ---
KALI_AGENT_TOKEN=change-me

# --- Lab Manager (internal network only, shared secret between api and labmanager) ---
LABMANAGER_TOKEN=change-me
