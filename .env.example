# --- General ---
ENVIRONMENT=development
API_SECRET_KEY=change-me-to-a-random-secret

# --- Ports exposed on the host (remapped to avoid conflicts with other local stacks) ---
FRONTEND_PORT=3300
API_PORT=8300
POSTGRES_PORT=55432
REDIS_PORT=63790

# --- PostgreSQL ---
POSTGRES_DB=cyberlab
POSTGRES_USER=cyberlab
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://cyberlab-redis:6379/0

# --- Ollama (reuses the Ollama instance already running on the host) ---
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# --- CORS ---
CORS_ORIGINS=http://localhost:3300
